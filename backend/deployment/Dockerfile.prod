FROM docker.io/library/python:3.13-slim-trixie AS django

WORKDIR /app

ENV PYTHONFAULTHANDLER=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

COPY requirements.txt .

RUN pip install -r requirements.txt

COPY mj mj
COPY events events
COPY scraping scraping
COPY templates templates
COPY manage.py setup.py ./

RUN pip install .

RUN useradd -u 5000 app && chown app:app /app
USER app:app

CMD ["gunicorn", "--bind", ":8000", "--access-logfile", "-", "--error-logfile", "-", "-k", "uvicorn.workers.UvicornWorker", "mj.asgi:application"]

# static files
FROM django AS staticfiles-prep

COPY .env.example .env

RUN python manage.py collectstatic --no-input

# precompress with gzip
RUN find /app/static \
  -type f -regextype posix-extended \
  -size +512c \
  -iregex '.*\.(css|csv|html?|js|svg|txt|xml|json|webmanifest|ttf)' \
  -exec gzip -9 -k '{}' \;

FROM ghcr.io/nginx/nginx-unprivileged:1.31.10-alpine3.24-slim@sha256:f4afc48254dc77ea692ec6979d220e5b1176331c636a4d51c502ffdded6789bd AS staticfiles

COPY --chown=101 deployment/api-static.nginx.conf /etc/nginx/conf.d/default.conf

COPY --chown=101 --from=staticfiles-prep /app/static /www/static

# Repeat django stage to make it the final one
FROM django
